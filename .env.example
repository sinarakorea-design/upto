# Supabase 프로젝트 설정 > API 에서 복사. 두 값은 브라우저에 공개돼도 되는 값이다(권한은 DB 규칙이 막는다).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # 예전 프로젝트는 NEXT_PUBLIC_SUPABASE_ANON_KEY
# 서버 전용(결제 승인·정산). 절대 NEXT_PUBLIC_ 을 붙이지 않는다.
# SUPABASE_SERVICE_ROLE_KEY=
# TOSS_SECRET_KEY=
